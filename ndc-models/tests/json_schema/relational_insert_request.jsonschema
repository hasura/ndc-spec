{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Relational Insert Request",
  "type": "object",
  "properties": {
    "collection": {
      "description": "The name of the collection to insert into",
      "type": "string"
    },
    "arguments": {
      "description": "Values to be provided to any collection arguments",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/Argument"
      }
    },
    "columns": {
      "description": "The columns to insert values for",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "description": "The rows to insert, each row containing values for the specified columns",
      "type": "array",
      "items": {
        "type": "array",
        "items": true
      }
    }
  },
  "required": [
    "collection",
    "arguments",
    "columns",
    "rows"
  ],
  "definitions": {
    "Argument": {
      "title": "Argument",
      "oneOf": [
        {
          "description": "The argument is provided by reference to a variable.\nOnly used if the 'query.variables' capability is supported.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "variable"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "name"
          ]
        },
        {
          "description": "The argument is provided as a literal value",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "literal"
            },
            "value": true
          },
          "required": [
            "type",
            "value"
          ]
        }
      ]
    }
  }
}