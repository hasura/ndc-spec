        {
          "description": "Returns the value of `expr` evaluated at the row that is `offset` rows\nbefore the current row within the window partition. When that row falls\noutside the partition, `default` is returned if provided, otherwise SQL\nNULL.\n\nOnly used when in specific contexts where the appropriate capability is supported:\n* During projection: `relational_query.project.expression.window.lag`\n* During filtering: `relational_query.filter.window.lag`\n* During sorting:`relational_query.sort.expression.window.lag`\n* During joining: `relational_query.join.expression.window.lag`\n* During aggregation: `relational_query.window.lag`\n* During windowing: `relational_query.window.expression.window.lag`",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "lag"
            },
            "expr": {
              "description": "The expression whose value is to be read from the offset row.",
              "allOf": [
                {
                  "$ref": "#/definitions/RelationalExpression"
                }
              ]
            },
            "offset": {
              "description": "The number of rows before the current row to read from. Producers\nemit `1` when the SQL text omits an explicit offset. Expected to be\nnon-negative; a negative offset reverses the direction (reading\nforwards, as `lead` would).",
              "type": "integer",
              "format": "int64"
            },
            "default": {
              "description": "The value to substitute when the offset row lies outside the\npartition. `None` means SQL NULL.",
              "anyOf": [
                {
                  "$ref": "#/definitions/RelationalExpression"
                },
                {
                  "type": "null"
                }
              ]
            },
            "order_by": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Sort"
              }
            },
            "partition_by": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/RelationalExpression"
              }
            }
          },
          "required": [
            "type",
            "expr",
            "offset",
            "order_by",
            "partition_by"
          ]
        },
        {
          "description": "Returns the value of `expr` evaluated at the row that is `offset` rows\nafter the current row within the window partition. When that row falls\noutside the partition, `default` is returned if provided, otherwise SQL\nNULL.\n\nOnly used when in specific contexts where the appropriate capability is supported:\n* During projection: `relational_query.project.expression.window.lead`\n* During filtering: `relational_query.filter.window.lead`\n* During sorting:`relational_query.sort.expression.window.lead`\n* During joining: `relational_query.join.expression.window.lead`\n* During aggregation: `relational_query.window.lead`\n* During windowing: `relational_query.window.expression.window.lead`",
