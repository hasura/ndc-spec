{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Relational Delete Request",
  "type": "object",
  "properties": {
    "collection": {
      "description": "The name of the collection to delete from",
      "type": "string"
    },
    "arguments": {
      "description": "Values to be provided to any collection arguments",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/Argument"
      }
    },
    "relation": {
      "description": "The relation that identifies which rows to delete",
      "allOf": [
        {
          "$ref": "#/definitions/Relation"
        }
      ]
    }
  },
  "required": [
    "collection",
    "arguments",
    "relation"
  ],
  "definitions": {
    "Argument": {
      "title": "Argument",
      "oneOf": [
        {
          "description": "The argument is provided by reference to a variable.\nOnly used if the 'query.variables' capability is supported.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "variable"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "name"
          ]
        },
        {
          "description": "The argument is provided as a literal value",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "literal"
            },
            "value": true
          },
          "required": [
            "type",
            "value"
          ]
        }
      ]
    },
    "CaseWhen": {
      "title": "CaseWhen",
      "type": "object",
      "properties": {
        "when": {
          "$ref": "#/definitions/RelationalExpression"
        },
        "then": {
          "$ref": "#/definitions/RelationalExpression"
        }
      },
      "required": [
        "when",
        "then"
      ]
    },
    "CastType": {
      "title": "CastType",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "boolean"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "utf-8 encoded string.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "utf8"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "signed 8bit int",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "int8"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "signed 16bit int",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "int16"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "signed 32bit int",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "int32"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "signed 64bit int",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "int64"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "unsigned 8bit int",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "uint8"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "unsigned 16bit int",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "uint16"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "unsigned 32bit int",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "uint32"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "unsigned 64bit int",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "uint64"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "32bit float",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "float32"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "64bit float",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "float64"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "128-bit decimal",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "decimal128"
            },
            "scale": {
              "type": "integer",
              "format": "int8",
              "minimum": -128,
              "maximum": 127
            },
            "prec": {
              "type": "integer",
              "format": "uint8",
              "minimum": 0,
              "maximum": 255
            }
          },
          "required": [
            "type",
            "scale",
            "prec"
          ]
        },
        {
          "description": "256-bit decimal",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "decimal256"
            },
            "scale": {
              "type": "integer",
              "format": "int8",
              "minimum": -128,
              "maximum": 127
            },
            "prec": {
              "type": "integer",
              "format": "uint8",
              "minimum": 0,
              "maximum": 255
            }
          },
          "required": [
            "type",
            "scale",
            "prec"
          ]
        },
        {
          "description": "date",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "date"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "time",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "time"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "ISO 8601 timestamp",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "timestamp"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "duration",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "duration"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "interval",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "interval"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "DatePartUnit": {
      "title": "DatePartUnit",
      "type": "string",
      "enum": [
        "year",
        "quarter",
        "month",
        "week",
        "day_of_week",
        "day_of_year",
        "day",
        "hour",
        "minute",
        "second",
        "microsecond",
        "millisecond",
        "nanosecond",
        "epoch"
      ]
    },
    "JoinOn": {
      "title": "JoinOn",
      "type": "object",
      "properties": {
        "left": {
          "$ref": "#/definitions/RelationalExpression"
        },
        "right": {
          "$ref": "#/definitions/RelationalExpression"
        }
      },
      "required": [
        "left",
        "right"
      ]
    },
    "JoinType": {
      "title": "JoinType",
      "oneOf": [
        {
          "description": "Only used when the capability `relational_query.join.join_types.left` is supported.",
          "type": "string",
          "const": "left"
        },
        {
          "description": "Only used when the capability `relational_query.join.join_types.right` is supported.",
          "type": "string",
          "const": "right"
        },
        {
          "description": "Only used when the capability `relational_query.join.join_types.inner` is supported.",
          "type": "string",
          "const": "inner"
        },
        {
          "description": "Only used when the capability `relational_query.join.join_types.full` is supported.",
          "type": "string",
          "const": "full"
        },
        {
          "description": "Only used when the capability `relational_query.join.join_types.left_anti` is supported.",
          "type": "string",
          "const": "left_anti"
        },
        {
          "description": "Only used when the capability `relational_query.join.join_types.left_semi` is supported.",
          "type": "string",
          "const": "left_semi"
        },
        {
          "description": "Only used when the capability `relational_query.join.join_types.right_anti` is supported.",
          "type": "string",
          "const": "right_anti"
        },
        {
          "description": "Only used when the capability `relational_query.join.join_types.right_semi` is supported.",
          "type": "string",
          "const": "right_semi"
        }
      ]
    },
    "NullsSort": {
      "title": "Nulls Sort",
      "type": "string",
      "enum": [
        "nulls_first",
        "nulls_last"
      ]
    },
    "OrderDirection": {
      "title": "Order Direction",
      "type": "string",
      "enum": [
        "asc",
        "desc"
      ]
    },
    "Relation": {
      "title": "Relation",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "from"
            },
            "collection": {
              "type": "string"
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "arguments": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/RelationalLiteral"
              }
            }
          },
          "required": [
            "type",
            "collection",
            "columns"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "paginate"
            },
            "input": {
              "$ref": "#/definitions/Relation"
            },
            "fetch": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "skip": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "input",
            "skip"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "project"
            },
            "input": {
              "$ref": "#/definitions/Relation"
            },
            "exprs": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/RelationalExpression"
              }
            }
          },
          "required": [
            "type",
            "input",
            "exprs"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "filter"
            },
            "input": {
              "$ref": "#/definitions/Relation"
            },
            "predicate": {
              "$ref": "#/definitions/RelationalExpression"
            }
          },
          "required": [
            "type",
            "input",
            "predicate"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "sort"
            },
            "input": {
              "$ref": "#/definitions/Relation"
            },
            "exprs": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Sort"
              }
            }
          },
          "required": [
            "type",
            "input",
            "exprs"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "join"
            },
            "left": {
              "$ref": "#/definitions/Relation"
            },
            "right": {
              "$ref": "#/definitions/Relation"
            },
            "on": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/JoinOn"
              }
            },
            "join_type": {
              "$ref": "#/definitions/JoinType"
            }
          },
          "required": [
            "type",
            "left",
            "right",
            "on",
            "join_type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "aggregate"
            },
            "input": {
              "$ref": "#/definitions/Relation"
            },
            "group_by": {
              "description": "Only non-empty if the 'relational_query.aggregate.group_by' capability is supported.",
              "type": "array",
              "items": {
                "$ref": "#/definitions/RelationalExpression"
              }
            },
            "aggregates": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/RelationalExpression"
              }
            }
          },
          "required": [
            "type",
            "input",
            "group_by",
            "aggregates"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "window"
            },
            "input": {
              "$ref": "#/definitions/Relation"
            },
            "exprs": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/RelationalExpression"
              }
            }
          },
          "required": [
            "type",
            "input",
            "exprs"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "union"
            },
            "relations": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Relation"
              }
            }
          },
          "required": [
            "type",
            "relations"
          ]
        }
      ]
    },
    "RelationalExpression": {
      "title": "RelationalExpression",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "literal"
            },
            "literal": {
              "$ref": "#/definitions/RelationalLiteral"
            }
          },
          "required": [
            "type",
            "literal"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "column"
            },
            "index": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "index"
          ]
        },
        {
          "description": "Only used when in specific contexts where the appropriate capability is supported:\n* During projection: `relational_query.project.expression.conditional.case`\n* During filtering: `relational_query.filter.conditional.case`\n* During sorting:`relational_query.sort.expression.conditional.case`\n* During joining: `relational_query.join.expression.conditional.case`\n* During aggregation: `relational_query.aggregate.expression.conditional.case`\n* During windowing: `relational_query.window.expression.conditional.case`",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "case"
            },
            "scrutinee": {
              "anyOf": [
                {
                  "$ref": "#/definitions/RelationalExpression"
                },
                {
                  "type": "null"
                }
              ]
            },
            "when": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/CaseWhen"
              }
            },
            "default": {
              "anyOf": [
                {
                  "$ref": "#/definitions/RelationalExpression"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "when"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "and"
            },
            "left": {
              "$ref": "#/definitions/RelationalExpression"
            },
            "right": {
              "$ref": "#/definitions/RelationalExpression"
            }
          },
          "required": [
            "type",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "or"
            },
            "left": {
              "$ref": "#/definitions/RelationalExpression"
            },
            "right": {
              "$ref": "#/definitions/RelationalExpression"
            }
          },
          "required": [
            "type",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "not"
            },
            "expr": {
              "$ref": "#/definitions/RelationalExpression"
            }
          },
          "required": [
            "type",
            "expr"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "eq"
            },
            "left": {
              "$ref": "#/definitions/RelationalExpression"
            },
            "right": {
              "$ref": "#/definitions/RelationalExpression"
            }
          },
          "required": [
            "type",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "not_eq"
            },
            "left": {
              "$ref": "#/definitions/RelationalExpression"
            },
            "right": {
              "$ref": "#/definitions/RelationalExpression"
            }
          },
          "required": [
            "type",
            "left",
            "right"
          ]
        },
        {
          "description": "Only used when in specific contexts where the appropriate capability is supported:\n* During projection: `relational_query.project.expression.comparison.is_distinct_from`\n* During filtering: `relational_query.filter.comparison.is_distinct_from`\n* During sorting:`relational_query.sort.expression.comparison.is_distinct_from`\n* During joining: `relational_query.join.expression.comparison.is_distinct_from`\n* During aggregation: `relational_query.aggregate.expression.comparison.is_distinct_from`\n* During windowing: `relational_query.window.expression.comparison.is_distinct_from`",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "is_distinct_from"
            },
            "left": {
              "$ref": "#/definitions/RelationalExpression"
            },
            "right": {
              "$ref": "#/definitions/RelationalExpression"
            }
          },
          "required": [
            "type",
            "left",
            "right"
          ]
        },
        {
          "description": "Only used when in specific contexts where the appropriate capability is supported:\n* During projection: `relational_query.project.expression.comparison.is_not_distinct_from`\n* During filtering: `relational_query.filter.comparison.is_not_distinct_from`\n* During sorting:`relational_query.sort.expression.comparison.is_not_distinct_from`\n* During joining: `relational_query.join.expression.comparison.is_not_distinct_from`\n* During aggregation: `relational_query.aggregate.expression.comparison.is_not_distinct_from`\n* During windowing: `relational_query.window.expression.comparison.is_not_distinct_from`",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "is_not_distinct_from"
            },
            "left": {
              "$ref": "#/definitions/RelationalExpression"
            },
            "right": {
              "$ref": "#/definitions/RelationalExpression"
            }
          },
          "required": [
            "type",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "lt"
            },
            "left": {
              "$ref": "#/definitions/RelationalExpression"
            },
            "right": {
              "$ref": "#/definitions/RelationalExpression"
            }
          },
          "required": [
            "type",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "lt_eq"
            },
            "left": {
              "$ref": "#/definitions/RelationalExpression"
            },
            "right": {
              "$ref": "#/definitions/RelationalExpression"
            }
          },
          "required": [
            "type",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "gt"
            },
            "left": {
              "$ref": "#/definitions/RelationalExpression"
            },
            "right": {
              "$ref": "#/definitions/RelationalExpression"
            }
          },
          "required": [
            "type",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "gt_eq"
            },
            "left": {
              "$ref": "#/definitions/RelationalExpression"
            },
            "right": {
              "$ref": "#/definitions/RelationalExpression"
            }
          },
          "required": [
            "type",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "is_not_null"
            },
            "expr": {
              "$ref": "#/definitions/RelationalExpression"
            }
          },
          "required": [
            "type",
            "expr"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "is_null"
            },
            "expr": {
              "$ref": "#/definitions/RelationalExpression"
            }
          },
          "required": [
            "type",
            "expr"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "is_true"
            },
            "expr": {
              "$ref": "#/definitions/RelationalExpression"
            }
          },
          "required": [
            "type",
            "expr"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "is_false"
            },
            "expr": {
              "$ref": "#/definitions/RelationalExpression"
            }
          },
          "required": [
            "type",
            "expr"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "is_not_true"
            },
            "expr": {
              "$ref": "#/definitions/RelationalExpression"
            }
          },
          "required": [
            "type",
            "expr"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "is_not_false"
            },
            "expr": {
              "$ref": "#/definitions/RelationalExpression"
            }
