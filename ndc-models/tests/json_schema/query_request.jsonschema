{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Query Request",
  "description": "This is the request body of the query POST endpoint",
  "type": "object",
  "properties": {
    "collection": {
      "description": "The name of a collection",
      "type": "string"
    },
    "query": {
      "description": "The query syntax tree",
      "allOf": [
        {
          "$ref": "#/definitions/Query"
        }
      ]
    },
    "arguments": {
      "description": "Values to be provided to any collection arguments",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/Argument"
      }
    },
    "collection_relationships": {
      "description": "Any relationships between collections involved in the query request.\nOnly used if the 'relationships' capability is supported.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/Relationship"
      }
    },
    "variables": {
      "description": "One set of named variables for each rowset to fetch. Each variable set\nshould be subtituted in turn, and a fresh set of rows returned.\nOnly used if the 'query.variables' capability is supported.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "request_arguments": {
      "description": "Values to be provided to request-level arguments.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "collection",
    "query",
    "arguments",
    "collection_relationships"
  ],
  "definitions": {
    "Aggregate": {
      "title": "Aggregate",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "column_count"
            },
            "column": {
              "description": "The column to apply the count aggregate function to",
              "type": "string"
            },
            "arguments": {
              "description": "Arguments to satisfy the column specified by 'column'",
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/Argument"
              }
            },
            "field_path": {
              "description": "Path to a nested field within an object column",
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "distinct": {
              "description": "Whether or not only distinct items should be counted",
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "column",
            "distinct"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "single_column"
            },
            "column": {
              "description": "The column to apply the aggregation function to",
              "type": "string"
            },
            "arguments": {
              "description": "Arguments to satisfy the column specified by 'column'",
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/Argument"
              }
            },
            "field_path": {
              "description": "Path to a nested field within an object column",
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "function": {
              "description": "Single column aggregate function name.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "column",
            "function"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "star_count"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "Argument": {
      "title": "Argument",
      "oneOf": [
        {
          "description": "The argument is provided by reference to a variable.\nOnly used if the 'query.variables' capability is supported.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "variable"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "name"
          ]
        },
        {
          "description": "The argument is provided as a literal value",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "literal"
            },
            "value": true
          },
          "required": [
            "type",
            "value"
          ]
        }
      ]
    },
    "ArrayComparison": {
      "title": "Array Comparison",
      "oneOf": [
        {
          "description": "Check if the array contains the specified value.\nOnly used if the 'query.nested_fields.filter_by.nested_arrays.contains' capability is supported.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "contains"
            },
            "value": {
              "$ref": "#/definitions/ComparisonValue"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "Check is the array is empty.\nOnly used if the 'query.nested_fields.filter_by.nested_arrays.is_empty' capability is supported.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "is_empty"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "ComparisonTarget": {
      "title": "Comparison Target",
      "oneOf": [
        {
          "description": "The comparison targets a column.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "column"
            },
            "name": {
              "description": "The name of the column",
              "type": "string"
            },
            "arguments": {
              "description": "Arguments to satisfy the column specified by 'name'",
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/Argument"
              }
            },
            "field_path": {
              "description": "Path to a nested field within an object column.\nOnly non-empty if the 'query.nested_fields.filter_by' capability is supported.",
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "type",
            "name"
          ]
        },
        {
          "description": "The comparison targets the result of aggregation.\nOnly used if the 'query.aggregates.filter_by' capability is supported.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "aggregate"
            },
            "path": {
              "description": "Non-empty collection of relationships to traverse",
              "type": "array",
              "items": {
                "$ref": "#/definitions/PathElement"
              }
            },
            "aggregate": {
              "description": "The aggregation method to use",
              "allOf": [
                {
                  "$ref": "#/definitions/Aggregate"
                }
              ]
            }
          },
          "required": [
            "type",
            "path",
            "aggregate"
          ]
        }
      ]
    },
    "ComparisonValue": {
      "title": "Comparison Value",
      "oneOf": [
        {
          "description": "The value to compare against should be drawn from another column",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "column"
            },
            "path": {
              "description": "Any relationships to traverse to reach this column.\nOnly non-empty if the 'relationships.relation_comparisons' is supported.",
              "type": "array",
              "items": {
                "$ref": "#/definitions/PathElement"
              }
            },
            "name": {
              "description": "The name of the column",
              "type": "string"
            },
            "arguments": {
              "description": "Arguments to satisfy the column specified by 'name'",
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/Argument"
              }
            },
            "field_path": {
              "description": "Path to a nested field within an object column.\nOnly non-empty if the 'query.nested_fields.filter_by' capability is supported.",
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "scope": {
              "description": "The scope in which this column exists, identified\nby an top-down index into the stack of scopes.\nThe stack grows inside each `Expression::Exists`,\nso scope 0 (the default) refers to the current collection,\nand each subsequent index refers to the collection outside\nits predecessor's immediately enclosing `Expression::Exists`\nexpression.\nOnly used if the 'query.exists.named_scopes' capability is supported.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "path",
            "name"
          ]
        },
        {
          "description": "A scalar value to compare against",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "scalar"
            },
            "value": true
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "A value to compare against that is to be drawn from the query's variables.\nOnly used if the 'query.variables' capability is supported.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "variable"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "name"
          ]
        }
      ]
    },
    "Dimension": {
      "title": "Dimension",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "column"
            },
            "path": {
              "description": "Any (object) relationships to traverse to reach this column.\nOnly non-empty if the 'relationships' capability is supported.",
              "type": "array",
              "items": {
                "$ref": "#/definitions/PathElement"
              }
            },
            "column_name": {
              "description": "The name of the column",
              "type": "string"
            },
            "arguments": {
              "description": "Arguments to satisfy the column specified by 'column_name'",
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/Argument"
              }
            },
            "field_path": {
              "description": "Path to a nested field within an object column",
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "extraction": {
              "description": "The name of the extraction function to apply to the selected value, if any",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "path",
            "column_name"
          ]
        }
      ]
    },
    "ExistsInCollection": {
      "title": "Exists In Collection",
      "oneOf": [
        {
          "description": "The rows to evaluate the exists predicate against come from a related collection.\nOnly used if the 'relationships' capability is supported.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "related"
            },
            "field_path": {
              "description": "Path to a nested field within an object column that must be navigated\nbefore the relationship is navigated.\nOnly non-empty if the 'relationships.nested.filtering' capability is supported.",
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "relationship": {
              "description": "The name of the relationship to follow",
              "type": "string"
            },
            "arguments": {
              "description": "Values to be provided to any collection arguments",
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/RelationshipArgument"
              }
            }
          },
          "required": [
            "type",
            "relationship",
            "arguments"
          ]
        },
        {
          "description": "The rows to evaluate the exists predicate against come from an unrelated collection\nOnly used if the 'query.exists.unrelated' capability is supported.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "unrelated"
            },
            "collection": {
              "description": "The name of a collection",
              "type": "string"
            },
            "arguments": {
              "description": "Values to be provided to any collection arguments",
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/RelationshipArgument"
              }
            }
          },
          "required": [
            "type",
            "collection",
            "arguments"
          ]
        },
        {
          "description": "The rows to evaluate the exists predicate against come from a nested array field.\nOnly used if the 'query.exists.nested_collections' capability is supported.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "nested_collection"
            },
            "column_name": {
              "type": "string"
            },
            "arguments": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/Argument"
              }
            },
            "field_path": {
              "description": "Path to a nested collection via object columns",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "type",
            "column_name"
          ]
        },
        {
          "description": "Specifies a column that contains a nested array of scalars. The\narray will be brought into scope of the nested expression where\neach element becomes an object with one '__value' column that\ncontains the element value.\nOnly used if the 'query.exists.nested_scalar_collections' capability is supported.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "nested_scalar_collection"
            },
            "column_name": {
              "type": "string"
            },
            "arguments": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/Argument"
              }
            },
            "field_path": {
              "description": "Path to a nested collection via object columns",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "type",
            "column_name"
          ]
        }
      ]
    },
    "Expression": {
      "title": "Expression",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "and"
            },
            "expressions": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Expression"
              }
            }
          },
          "required": [
            "type",
            "expressions"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "or"
            },
            "expressions": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Expression"
              }
            }
          },
          "required": [
            "type",
            "expressions"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "not"
            },
            "expression": {
              "$ref": "#/definitions/Expression"
            }
          },
          "required": [
            "type",
            "expression"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "unary_comparison_operator"
            },
            "column": {
              "$ref": "#/definitions/ComparisonTarget"
            },
            "operator": {
              "$ref": "#/definitions/UnaryComparisonOperator"
            }
          },
          "required": [
            "type",
            "column",
            "operator"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "binary_comparison_operator"
            },
            "column": {
              "$ref": "#/definitions/ComparisonTarget"
            },
            "operator": {
              "type": "string"
            },
            "value": {
              "$ref": "#/definitions/ComparisonValue"
            }
          },
          "required": [
            "type",
            "column",
            "operator",
            "value"
          ]
        },
        {
          "description": "A comparison against a nested array column.\nOnly used if the 'query.nested_fields.filter_by.nested_arrays' capability is supported.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "array_comparison"
            },
            "column": {
              "$ref": "#/definitions/ComparisonTarget"
            },
            "comparison": {
              "$ref": "#/definitions/ArrayComparison"
            }
          },
          "required": [
            "type",
            "column",
            "comparison"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "exists"
            },
            "in_collection": {
              "$ref": "#/definitions/ExistsInCollection"
            },
            "predicate": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Expression"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "in_collection"
          ]
        }
      ]
    },
    "Field": {
      "title": "Field",
      "oneOf": [
        {
          "description": "A field satisfied by returning the value of a row's column.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "column"
            },
            "column": {
              "type": "string"
            },
            "fields": {
              "description": "When the type of the column is a (possibly-nullable) array or object,\nthe caller can request a subset of the complete column data,\nby specifying fields to fetch here.\nIf omitted, the column data will be fetched in full.",
              "anyOf": [
                {
                  "$ref": "#/definitions/NestedField"
                },
                {
                  "type": "null"
                }
              ]
            },
            "arguments": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/Argument"
              }
            }
          },
          "required": [
            "type",
            "column"
          ]
        },
        {
          "description": "A field satisfied by navigating a relationship from the current row to a related collection.\nOnly used if the 'relationships' capability is supported.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "relationship"
            },
            "query": {
              "$ref": "#/definitions/Query"
            },
            "relationship": {
              "description": "The name of the relationship to follow for the subquery",
              "type": "string"
            },
            "arguments": {
              "description": "Values to be provided to any collection arguments",
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/RelationshipArgument"
              }
            }
          },
          "required": [
            "type",
            "query",
            "relationship",
            "arguments"
          ]
        }
      ]
    },
    "GroupComparisonTarget": {
      "title": "Aggregate Comparison Target",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "aggregate"
            },
            "aggregate": {
              "$ref": "#/definitions/Aggregate"
            }
          },
          "required": [
            "type",
            "aggregate"
          ]
        }
      ]
    },
    "GroupComparisonValue": {
      "title": "Aggregate Comparison Value",
      "oneOf": [
        {
          "description": "A scalar value to compare against",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "scalar"
            },
            "value": true
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "description": "A value to compare against that is to be drawn from the query's variables.\nOnly used if the 'query.variables' capability is supported.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "variable"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "name"
          ]
        }
      ]
    },
    "GroupExpression": {
      "title": "Group Expression",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "and"
            },
            "expressions": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GroupExpression"
              }
            }
          },
          "required": [
            "type",
            "expressions"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "or"
            },
            "expressions": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/GroupExpression"
              }
            }
          },
          "required": [
            "type",
            "expressions"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "not"
            },
            "expression": {
              "$ref": "#/definitions/GroupExpression"
            }
          },
          "required": [
            "type",
            "expression"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "unary_comparison_operator"
            },
            "target": {
              "$ref": "#/definitions/GroupComparisonTarget"
            },
            "operator": {
              "$ref": "#/definitions/UnaryComparisonOperator"
            }
          },
          "required": [
            "type",
            "target",
            "operator"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "binary_comparison_operator"
            },
            "target": {
              "$ref": "#/definitions/GroupComparisonTarget"
            },
            "operator": {
              "type": "string"
            },
            "value": {
              "$ref": "#/definitions/GroupComparisonValue"
            }
          },
          "required": [
            "type",
            "target",
            "operator",
            "value"
          ]
        }
      ]
    },
    "GroupOrderBy": {
      "title": "Group Order By",
      "type": "object",
      "properties": {
        "elements": {
          "description": "The elements to order by, in priority order",
          "type": "array",
          "items": {
            "$ref": "#/definitions/GroupOrderByElement"
          }
        }
      },
      "required": [
        "elements"
      ]
    },
    "GroupOrderByElement": {
      "title": "Group Order By Element",
      "type": "object",
      "properties": {
        "order_direction": {
          "$ref": "#/definitions/OrderDirection"
        },
        "target": {
          "$ref": "#/definitions/GroupOrderByTarget"
        }
      },
      "required": [
        "order_direction",
        "target"
      ]
    },
    "GroupOrderByTarget": {
      "title": "Group Order By Target",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "dimension"
            },
            "index": {
              "description": "The index of the dimension to order by, selected from the\ndimensions provided in the `Grouping` request.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "index"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "aggregate"
            },
            "aggregate": {
              "description": "Aggregation method to apply",
              "allOf": [
                {
                  "$ref": "#/definitions/Aggregate"
                }
              ]
            }
          },
          "required": [
            "type",
            "aggregate"
          ]
        }
      ]
    },
    "Grouping": {
      "title": "Grouping",
      "type": "object",
      "properties": {
        "dimensions": {
          "description": "Dimensions along which to partition the data",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Dimension"
          }
        },
        "aggregates": {
          "description": "Aggregates to compute in each group",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Aggregate"
          }
        },
        "predicate": {
          "description": "Optionally specify a predicate to apply after grouping rows.\nOnly used if the 'query.aggregates.group_by.filter' capability is supported.",
          "anyOf": [
            {
              "$ref": "#/definitions/GroupExpression"
            },
            {
              "type": "null"
            }
          ]
        },
        "order_by": {
          "description": "Optionally specify how groups should be ordered\nOnly used if the 'query.aggregates.group_by.order' capability is supported.",
          "anyOf": [
            {
              "$ref": "#/definitions/GroupOrderBy"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "description": "Optionally limit to N groups\nOnly used if the 'query.aggregates.group_by.paginate' capability is supported.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "offset": {
          "description": "Optionally offset from the Nth group\nOnly used if the 'query.aggregates.group_by.paginate' capability is supported.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "dimensions",
        "aggregates"
      ]
    },
    "NestedArray": {
      "title": "NestedArray",
      "type": "object",
      "properties": {
        "fields": {
          "$ref": "#/definitions/NestedField"
        }
      },
      "required": [
        "fields"
      ]
    },
    "NestedCollection": {
      "title": "NestedCollection",
      "type": "object",
      "properties": {
        "query": {
          "$ref": "#/definitions/Query"
        }
      },
      "required": [
        "query"
      ]
    },
    "NestedField": {
      "title": "NestedField",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "object"
            }
          },
          "required": [
            "type"
          ],
          "allOf": [
            {
              "$ref": "#/definitions/NestedObject"
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "array"
            }
          },
          "required": [
            "type"
          ],
          "allOf": [
            {
              "$ref": "#/definitions/NestedArray"
            }
          ]
        },
        {
          "description": "Perform a query over the nested array's rows.\nOnly used if the 'query.nested_fields.nested_collections' capability is supported.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "collection"
            }
          },
          "required": [
            "type"
          ],
          "allOf": [
            {
              "$ref": "#/definitions/NestedCollection"
            }
          ]
        }
      ]
    },
    "NestedObject": {
      "title": "NestedObject",
      "type": "object",
      "properties": {
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Field"
          }
        }
      },
      "required": [
        "fields"
      ]
    },
    "OrderBy": {
      "title": "Order By",
      "type": "object",
      "properties": {
        "elements": {
          "description": "The elements to order by, in priority order",
          "type": "array",
          "items": {
            "$ref": "#/definitions/OrderByElement"
          }
        }
      },
      "required": [
        "elements"
      ]
    },
    "OrderByElement": {
      "title": "Order By Element",
      "type": "object",
      "properties": {
        "order_direction": {
          "$ref": "#/definitions/OrderDirection"
        },
        "target": {
          "$ref": "#/definitions/OrderByTarget"
        }
      },
      "required": [
        "order_direction",
        "target"
      ]
    },
    "OrderByTarget": {
      "title": "Order By Target",
      "oneOf": [
        {
          "description": "The ordering is performed over a column.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "column"
            },
            "path": {
              "description": "Any (object) relationships to traverse to reach this column.\nOnly non-empty if the 'relationships' capability is supported.\n'PathElement.field_path' will only be non-empty if the 'relationships.nested.ordering' capability is supported.",
              "type": "array",
              "items": {
                "$ref": "#/definitions/PathElement"
              }
            },
            "name": {
              "description": "The name of the column",
              "type": "string"
            },
            "arguments": {
              "description": "Arguments to satisfy the column specified by 'name'",
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/Argument"
              }
            },
            "field_path": {
              "description": "Path to a nested field within an object column.\nOnly non-empty if the 'query.nested_fields.order_by' capability is supported.",
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "type",
            "path",
            "name"
          ]
        },
        {
          "description": "The ordering is performed over the result of an aggregation.\nOnly used if the 'relationships.order_by_aggregate' capability is supported.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "aggregate"
            },
            "path": {
              "description": "Non-empty collection of relationships to traverse.\nOnly non-empty if the 'relationships' capability is supported.\n'PathElement.field_path' will only be non-empty if the 'relationships.nested.ordering' capability is supported.",
              "type": "array",
              "items": {
                "$ref": "#/definitions/PathElement"
              }
            },
            "aggregate": {
              "description": "The aggregation method to use",
              "allOf": [
                {
                  "$ref": "#/definitions/Aggregate"
                }
              ]
            }
          },
          "required": [
            "type",
            "path",
            "aggregate"
          ]
        }
      ]
    },
    "OrderDirection": {
      "title": "Order Direction",
      "type": "string",
      "enum": [
        "asc",
        "desc"
      ]
    },
    "PathElement": {
      "title": "Path Element",
      "type": "object",
      "properties": {
        "field_path": {
          "description": "Path to a nested field within an object column that must be navigated\nbefore the relationship is navigated.\nOnly non-empty if the 'relationships.nested' capability is supported\n(plus perhaps one of the sub-capabilities, depending on the feature using the PathElement).",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "relationship": {
          "description": "The name of the relationship to follow",
          "type": "string"
        },
        "arguments": {
          "description": "Values to be provided to any collection arguments",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/RelationshipArgument"
          }
        },
        "predicate": {
          "description": "A predicate expression to apply to the target collection",
          "anyOf": [
            {
              "$ref": "#/definitions/Expression"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "relationship",
        "arguments"
      ]
    },
    "Query": {
      "title": "Query",
      "type": "object",
      "properties": {
        "aggregates": {
          "description": "Aggregate fields of the query.\nOnly used if the 'query.aggregates' capability is supported.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/definitions/Aggregate"
          }
        },
        "fields": {
          "description": "Fields of the query",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/definitions/Field"
          }
        },
        "limit": {
          "description": "Optionally limit to N results",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "offset": {
          "description": "Optionally offset from the Nth result",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "order_by": {
          "description": "Optionally specify how rows should be ordered",
          "anyOf": [
            {
              "$ref": "#/definitions/OrderBy"
            },
            {
              "type": "null"
            }
          ]
        },
        "predicate": {
          "description": "Optionally specify a predicate to apply to the rows",
          "anyOf": [
            {
              "$ref": "#/definitions/Expression"
            },
            {
              "type": "null"
            }
          ]
        },
        "groups": {
          "description": "Optionally group and aggregate the selected rows.\nOnly used if the 'query.aggregates.group_by' capability is supported.",
          "anyOf": [
            {
              "$ref": "#/definitions/Grouping"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Relationship": {
      "title": "Relationship",
      "type": "object",
      "properties": {
        "column_mapping": {
          "description": "A mapping between columns on the source row to columns on the target collection.\nThe column on the target collection is specified via a field path (ie. an array of field\nnames that descend through nested object fields). The field path will only contain a single item,\nmeaning a column on the target collection's type, unless the 'relationships.nested'\ncapability is supported, in which case multiple items denotes a nested object field.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "relationship_type": {
          "$ref": "#/definitions/RelationshipType"
        },
        "target_collection": {
          "description": "The name of a collection",
          "type": "string"
        },
        "arguments": {
          "description": "Values to be provided to any collection arguments",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/RelationshipArgument"
          }
        }
      },
      "required": [
        "column_mapping",
        "relationship_type",
        "target_collection",
        "arguments"
      ]
    },
    "RelationshipArgument": {
      "title": "Relationship Argument",
      "oneOf": [
        {
          "description": "The argument is provided by reference to a variable.\nOnly used if the 'query.variables' capability is supported.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "variable"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "name"
          ]
        },
        {
          "description": "The argument is provided as a literal value",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "literal"
            },
            "value": true
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "column"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "name"
          ]
        }
      ]
    },
    "RelationshipType": {
      "title": "Relationship Type",
      "type": "string",
      "enum": [
        "object",
        "array"
      ]
    },
    "UnaryComparisonOperator": {
      "title": "Unary Comparison Operator",
      "type": "string",
      "enum": [
        "is_null"
      ]
    }
  }
}